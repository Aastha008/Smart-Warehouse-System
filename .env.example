# AI Warehouse Intelligence - Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME=AI Warehouse Intelligence
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/warehouse_intelligence.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/warehouse_intelligence

# Model Configuration
MODEL_WEIGHTS=yolov8s.pt
MODEL_DEVICE=auto
CONFIDENCE_THRESHOLD=0.35

# AI Assistant (Optional - for LLM integration)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# Or use local model:
# LLM_PROVIDER=local
# LLM_MODEL_PATH=./models/llama-3.2-1b

# Video Processing
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_VIDEO_SIZE_MB=500
MAX_CONCURRENT_JOBS=2

# Alerts (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL_TO=supervisor@company.com

# Webhook (Optional)
# WEBHOOK_URL=https://hooks.slack.com/services/your-webhook

# Security
SECRET_KEY=change-this-to-a-random-secret-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Data Retention
VIDEO_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
